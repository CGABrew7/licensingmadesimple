      <p>Email us at <a href="mailto:privacy@licensingmadesimple.com">privacy@licensingmadesimple.com</a>.</p>
    </div>
  </section>
</Layout>

<style>
  .article p { font-size: 0.92rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 12px; }
</style>
