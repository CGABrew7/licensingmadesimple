---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — LicensingMadeSimple" description="Ask which license you need and which agency takes the filing.">
  <section class="page-hero">
    <div class="container">
      <h1>Contact Us</h1>
      <p>Get your questions answered within 1 business day.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 600px;">
      <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:36px;box-shadow:var(--shadow);">
        <h2 style="font-size:1.3rem;margin-bottom:8px;">Send Us a Message</h2>
        <p style="font-size:0.92rem;color:var(--text-secondary);margin-bottom:24px;">Tell us what you need and we'll respond with your options within 1 business day.</p>
        <form action="#" method="POST">
          <div class="form-group">
            <label>Your name</label>
            <input type="text" placeholder="Full name" required />
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" placeholder="you@company.com" required />
          </div>
          <div class="form-group">
            <label>What do you need help with?</label>
            <textarea rows="4" placeholder="Business type, state(s), and any questions you have." required style="width:100%;padding:14px 16px;border:1px solid var(--border);border-radius:10px;font-size:0.95rem;font-family:inherit;color:var(--text);background:var(--bg);resize:vertical;"></textarea>
          </div>
          <button type="submit" class="btn">Send Message</button>
          <p style="text-align:center;font-size:0.8rem;color:var(--text-muted);margin-top:10px;">No obligation. No sales pitch.</p>
        </form>
      </div>
    </div>
  </section>
</Layout>
