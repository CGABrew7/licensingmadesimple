    <section class="page-hero">
      <div class="container">
        <h1>No page at this address</h1>
        <p>This is a filing directory, not a coming-soon placeholder. Try the state index or a license type.</p>
      </div>
    </section>
    <section class="section">
      <div class="container">
        <p class="section-links">
          <a href="/directory">License directory</a>
          <a href="/states">50 states and DC</a>
          <a href="/">Home</a>
        </p>
      </div>
    </section>
  </div>
</Layout>
