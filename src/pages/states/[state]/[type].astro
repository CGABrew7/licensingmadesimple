---
import Layout from "../../../layouts/Layout.astro";
import DirectoryDisclaimer from "../../../components/DirectoryDisclaimer.astro";
import FileWithCornerstone from "../../../components/FileWithCornerstone.astro";
import LinkedText from "../../../components/LinkedText.astro";
import StatuteHistory from "../../../components/StatuteHistory.astro";
import StrikingSection from "../../../components/StrikingSection.astro";
import { faqPageSchema, getStrikingPage } from "../../../data/striking-pages";
import {
  breadcrumbSchema,
  buildLicensePage,
  faqSchema,
  howToSchema,
} from "../../../lib/license-page";
import { comboQuality } from "../../../lib/state-page-quality";
import { nationalHubLinks } from "../../../data/directory-hubs";
import {
  comboPath,
  coreLicenseTypes,
  coreSlugs,
  filingLabel,
  getLicenseType,
  getState,
  getStateLicense,
  licensePath,
  requiredLabel,
  statePath,
  states,
} from "../../../lib/directory";
import type { LicenseSlug } from "../../../data/license-types";
import type { CitedCell } from "../../../data/verified-requirements";
import { licenseStatuteHistory } from "../../../data/statute-history";

export function getStaticPaths() {
  return states.flatMap((s) =>
    coreSlugs.map((type) => ({
      params: { state: s.slug, type },
    })),
  );
}

const state = getState(Astro.params.state!);
const type = getLicenseType(Astro.params.type!);
if (!state || !type) throw new Error("Unknown state or license type");

const fact = getStateLicense(state.slug, type.slug as LicenseSlug);
if (!fact) throw new Error("Missing fact");

const striking = getStrikingPage(state.slug, type.slug);
const page = buildLicensePage(state, type, fact);
const quality = comboQuality(state, type);
const otherTypes = coreLicenseTypes.filter((t) => t.slug !== type.slug);
const otherStates = states.filter((s) => s.slug !== state.slug);
const strikingFaq = striking ? faqPageSchema(striking.faqs) : undefined;
const jsonLd = [
  breadcrumbSchema(state, type),
  faqSchema(page.faqs),
  ...(strikingFaq ? [strikingFaq] : []),
  howToSchema(page.howToName, page.steps),
];
const pageTitle = striking?.title ?? `${type.name} in ${state.name}: fee, bond, timeline, and where to file`;
const pageDescription = striking?.description ?? `${fact.licenseName} in ${state.name}. ${requiredLabel(fact.required)}. Fee, bond, and timeline cells cite a regulator, a statute, or the NMLS chart.`;

const nationalHub = nationalHubLinks().find((link) => link.href === licensePath(type.slug));
const statuteHistory = licenseStatuteHistory(state.slug, type.slug);
const rows: { label: string; cell: CitedCell }[] = [
  { label: "Fee", cell: page.fee },
  { label: "Bond", cell: page.bond },
  { label: "Timeline", cell: page.timeline },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
  robots={quality.indexable ? undefined : "noindex, follow"}
>
  <section class="page-hero">
    <div class="container">
      <nav class="lms-crumb" aria-label="Breadcrumb">
        <ol class="crumb-list">
          <li><a href="/">Home</a></li>
          <li><a href="/directory">Directory</a></li>
          <li><a href={statePath(state.slug)}>{state.name}</a></li>
          <li aria-current="page">{type.name}</li>
        </ol>
      </nav>
      <p class="lms-kicker">{state.abbr} · {type.vertical}</p>
      <h1>{striking?.h1 ?? `${type.name} in ${state.name}`}</h1>
      <p>{fact.licenseName}</p>
      {nationalHub && (
        <p class="hub-up">
          <a href={nationalHub.href}>{nationalHub.anchor}</a> is the national page. This page is {state.name} only.
        </p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      {quality.indexable && (
        <div class="lms-prose">
          {quality.paragraphs.map((paragraph) => (
            <p><LinkedText text={paragraph.text} links={paragraph.links} /></p>
          ))}
          <h2>Related pages</h2>
          <ul class="neighbor-list">
            {quality.related.map((link) => (
              <li><a href={link.href}>{link.anchor}</a></li>
            ))}
          </ul>
        </div>
      )}

      <div class="lms-factbar">
        <div>
          <span class="wr-item-label">Statewide license</span>
          <strong>{requiredLabel(fact.required)}</strong>
        </div>
        <div>
          <span class="wr-item-label">Filing path</span>
          <strong>{filingLabel(fact.filing)}</strong>
        </div>
        <div>
          <span class="wr-item-label">Agency</span>
          <strong><a href={fact.agencyUrl} target="_blank" rel="noopener">{fact.agencyName}</a></strong>
        </div>
      </div>

      <div class="req-block">
        <h2 class="section-title req-title">Fee, bond, and timeline</h2>
        <p class="section-sub req-lead">Each cell cites a state regulator, a statute, or the NMLS License Requirements and Fees Chart. If a figure could not be verified, the cell says Varies, see regulator and links the agency.</p>
        <div class="req-wrap">
          <table class="req-table">
            <thead>
              <tr>
                <th scope="col">Item</th>
                <th scope="col">Published figure</th>
                <th scope="col">Source</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td>{row.cell.value}</td>
                  <td>
                    {row.cell.sources.map((source, index) => (
                      <>
                        {index > 0 ? ", " : ""}
                        <a href={source.url} target="_blank" rel="noopener">{source.label}</a>
                      </>
                    ))}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="lms-verified">
          Last verified:{page.lastVerifiedLabel ? <> <time datetime={page.lastVerified}>{page.lastVerifiedLabel}</time></> : null}
        </p>
        <p class="tool-row">
          <a href={page.storeCostUrl} target="_blank" rel="noopener">LicenseStore cost page for {state.name}</a>
          <a href={page.storeCompareUrl} target="_blank" rel="noopener">LicenseStore compare</a>
          <a href={page.storeSourcesUrl} target="_blank" rel="noopener">LicenseStore sources</a>
        </p>
      </div>

      {statuteHistory && <StatuteHistory history={statuteHistory} />}

      <div class="lms-prose" style="margin-top:36px;">
        {striking?.placement === "before-who" && (
          <StrikingSection heading={striking.sectionHeading} paragraphs={striking.paragraphs} />
        )}

        <h2>{striking?.whoHeading ?? `Who needs this in ${state.name}`}</h2>
        <p>{fact.whoNeeds}</p>
        {striking?.whoExtra?.map((block) => (
          <p><LinkedText text={block.text} links={block.links ?? []} /></p>
        ))}

        {striking?.placement === "after-who" && (
          <StrikingSection heading={striking.sectionHeading} paragraphs={striking.paragraphs} />
        )}

        <h2>{striking?.whereHeading ?? "Where to file"}</h2>
        <p>{fact.path}</p>

        {fact.notes.length > 0 && (
          <>
            <h2>Notes</h2>
            {fact.notes.map((n) => <p>{n}</p>)}
          </>
        )}

        {page.sections.map((section) => (
          <>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </>
        ))}

        <h2>{page.howToName}</h2>
        <ol class="howto-steps">
          {page.steps.map((step) => (
            <li>
              <strong>{step.name}</strong>
              <span>{step.text}</span>
            </li>
          ))}
        </ol>

        <h2>Federal overlay</h2>
        <p>{type.federalOverlay}</p>

        <h2>Questions</h2>
        <div class="faq-list">
          {page.faqs.map((faq) => (
            <details class="faq-item">
              <summary class="faq-q">{faq.q}<span class="faq-toggle">+</span></summary>
              <div class="faq-a"><p>{faq.a}</p></div>
            </details>
          ))}
        </div>

        <h2>Sources</h2>
        <ul>
          {fact.sources.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>
          ))}
        </ul>

        {striking && (
          <div class="lms-faq" id="license-faq">
            <h2>FAQ</h2>
            {striking.faqs.map((item) => (
              <>
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">Other {state.name} filings</h2>
      <div class="card-grid">
        {otherTypes.map((t) => (
          <a class="card lms-dir-card" href={comboPath(state.slug, t.slug)}>
            <h3>{t.name}</h3>
            <p>Who needs it in {state.name}, and which desk takes the filing.</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {page.nearby.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="section-title">{type.name} in nearby states</h2>
        <ul class="neighbor-list">
          {page.nearby.map((neighbor) => (
            <li>
              <a href={comboPath(neighbor.slug, type.slug)}>{neighbor.name}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">{type.name} in other states</h2>
      <p class="lms-inline-states">
        {otherStates.map((s, i) => (
          <><a href={comboPath(s.slug, type.slug)}>{s.abbr}</a>{i < otherStates.length - 1 ? " · " : ""}</>
        ))}
      </p>
      <p class="section-links">
        <a href={licensePath(type.slug)}>{nationalHub?.anchor ?? `All ${type.name.toLowerCase()} states`}</a>
        <a href={statePath(state.slug)}>All {state.name} licenses</a>
        <a href="/guides/nmls">NMLS guide</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:720px;">
      {striking ? (
        <FileWithCornerstone
          heading={striking.cta.heading}
          body={striking.cta.body}
          buttonLabel={striking.cta.button}
          buttonHref={striking.cta.buttonHref}
          textLabel={striking.cta.text}
          textHref={striking.cta.textHref}
        />
      ) : (
        <FileWithCornerstone topic={`${type.shortName} work in ${state.name}`} />
      )}
      <p style="margin-top:12px;">
        <a href={type.cornerstoneUrl} target="_blank" rel="noopener">Cornerstone on {type.name.toLowerCase()}</a>
      </p>
      <DirectoryDisclaimer />
    </div>
  </section>
</Layout>
