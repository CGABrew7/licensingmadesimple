---
import Layout from "../../layouts/Layout.astro";
import "../../styles/desk.css";
import AuthorBox from "../../components/AuthorBox.astro";
import Byline from "../../components/Byline.astro";
import DirectoryDisclaimer from "../../components/DirectoryDisclaimer.astro";
import FileWithCornerstone from "../../components/FileWithCornerstone.astro";
import { getDirectoryHub } from "../../data/directory-hubs";
import { directoryIndexUpdated } from "../../lib/editorial";
import { adjacentLicenseTypes, coreLicenseTypes, licensePath, states } from "../../lib/directory";
---

<Layout
  title="License directory: who needs what, where to file"
  description="Collection, lending, money transmitter, and mortgage licenses in the 50 states and DC: who typically needs each one and which agency takes the filing."
>
  <div class="hp">
  <section class="page-hero">
    <div class="container">
      <p class="lms-kicker">Filing directory</p>
      <h1>Who needs the license, and where it is filed</h1>
      <p>
        Four core financial-services verticals, all 50 states and the District of Columbia. Official agencies, linked to the public source.
      </p>
      <Byline modified={directoryIndexUpdated} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Core licenses</h2>
      <p class="section-sub">The work this site exists to explain. Each type has a national overview and a page for every state.</p>
      <ul class="hp-core-list" role="list">
        {coreLicenseTypes.map((t) => {
          const hub = getDirectoryHub(t.slug);
          return (
            <li>
              <a class="hp-core-row" href={licensePath(t.slug)}>
                <p class="lms-kicker">{t.vertical}</p>
                <h3>{hub?.h1 ?? t.name}</h3>
                <p>{hub?.description ?? t.filingHint}</p>
                <span class="lms-card-link hp-core-go">Open {t.shortName} directory →</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">Browse by state</h2>
      <p class="section-sub">{states.length} state hubs. Each one lists the agencies and the four core filings.</p>
      <p>
        <a href="/states" class="btn-quiet">Open the state index</a>
      </p>
      <p class="lms-inline-states">
        {states.map((s, i) => (
          <><a href={`/states/${s.slug}`}>{s.abbr}</a>{i < states.length - 1 ? " · " : ""}</>
        ))}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Adjacent filings</h2>
      <p class="section-sub">Useful, but not the core of this site. Overviews only. We do not generate a page for every state for these.</p>
      <div class="card-grid">
        {adjacentLicenseTypes.map((t) => (
          <a class="card lms-dir-card" href={licensePath(t.slug)}>
            <h3>{t.name}</h3>
            <p>{t.filingHint}</p>
            <span class="lms-card-link">Who files, and where →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <FileWithCornerstone topic="the application" />
      <DirectoryDisclaimer />
      <AuthorBox />
    </div>
  </section>
  </div>
</Layout>
