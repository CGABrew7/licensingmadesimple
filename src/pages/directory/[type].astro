---
import Layout from "../../layouts/Layout.astro";
import DirectoryDisclaimer from "../../components/DirectoryDisclaimer.astro";
import FileWithCornerstone from "../../components/FileWithCornerstone.astro";
import LinkedText from "../../components/LinkedText.astro";
import { NMLS_CHART } from "../../data/chart-cells";
import {
  HUB_UPDATED,
  HUB_UPDATED_LABEL,
  getDirectoryHub,
  hubBreadcrumbSchema,
  hubWebPageSchema,
} from "../../data/directory-hubs";
import { faqPageSchema, inboundLinks } from "../../data/striking-pages";
import {
  comboPath,
  coreLicenseTypes,
  filingLabel,
  getFactsForLicense,
  getLicenseType,
  getState,
  licenseTypes,
  requiredLabel,
} from "../../lib/directory";

export function getStaticPaths() {
  return licenseTypes.map((t) => ({ params: { type: t.slug } }));
}

const type = getLicenseType(Astro.params.type!);
if (!type) throw new Error("Unknown license type");

const hub = getDirectoryHub(type.slug);
const isCore = type.tier === "core";
const filingPaths = isCore ? inboundLinks("directory", { license: type.slug }) : [];
const rows = isCore
  ? getFactsForLicense(type.slug).map(({ stateSlug, fact }) => ({
      state: getState(stateSlug)!,
      fact,
    }))
  : [];
const title = hub?.title ?? `${type.name} licenses — who needs one and where to file`;
const description = hub?.description ?? `${type.name}: who typically needs the license, which agency takes the filing, and ${isCore ? "a page for every state" : "how the filing desk works"}.`;
const jsonLd = hub ? [hubWebPageSchema(hub), hubBreadcrumbSchema(hub), faqPageSchema(hub.faqs)] : undefined;
const tableLeadLinks = hub?.slug === "money-transmitters"
  ? [{ phrase: "NMLS License Requirements and Fees Chart", href: NMLS_CHART.url }]
  : [];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container">
      <p class="lms-crumb"><a href="/directory">Directory</a> / {type.name}</p>
      <p class="lms-kicker">{type.vertical}</p>
      <h1>{hub?.h1 ?? type.name}</h1>
      {hub ? (
        <>
          <p class="lede"><LinkedText text={hub.lede} links={hub.ledeLinks} /></p>
          <p class="hub-byline">By LicensingMadeSimple · Last updated <time datetime={HUB_UPDATED}>{HUB_UPDATED_LABEL}</time></p>
          <div class="section-links hub-jumps">
            {hub.jumps.map((jump) => (
              <a href={jump.href}>{jump.label}</a>
            ))}
          </div>
        </>
      ) : (
        <p>{type.filingHint}</p>
      )}
    </div>
  </section>

  {hub ? (
    <section class="section">
      <div class="container lms-prose">
        {hub.sections.map((section) => (
          <>
            <h2 id={section.id}>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p><LinkedText text={paragraph.text} links={paragraph.links ?? []} /></p>
            ))}
          </>
        ))}
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="container lms-prose">
        <h2>Who needs this license</h2>
        <p>{type.whoNeeds}</p>

        <h2>Typical filing path</h2>
        <p>{type.typicalPath}</p>

        <h2>Federal layer</h2>
        <p>{type.federalOverlay}</p>

        {isCore && (
          <p>
            Open a state page for the agency, the filing path, and the fee, bond, and
            timeline table. Each cell cites a regulator, a statute, or the NMLS chart.
            If a figure could not be verified, the cell says Varies, see regulator.
          </p>
        )}
      </div>
    </section>
  )}

  {hub && (
    <section class="section section-alt" id={hub.tableId}>
      <div class="container">
        <h2 class="section-title">{hub.tableHeading}</h2>
        <p class="section-sub"><LinkedText text={hub.tableLead} links={tableLeadLinks} /></p>
        <div class="lms-table-wrap">
          <table class="lms-table hub-table">
            <thead>
              <tr>
                <th scope="col">State</th>
                <th scope="col">Statewide license</th>
                <th scope="col">Agency</th>
                <th scope="col">What differs in this state</th>
              </tr>
            </thead>
            <tbody>
              {hub.rows.map((row) => (
                <tr>
                  <td><a href={row.href}>{row.stateName}</a></td>
                  <td>{row.status}</td>
                  <td><a href={row.agencyUrl} target="_blank" rel="noopener">{row.agencyName}</a></td>
                  <td>
                    <p class="hub-note">{row.blurb}</p>
                    {row.cited && <p class="hub-cited">{row.cited}</p>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {filingPaths.length > 0 && (
          <>
            <h2 class="lms-subhead">State filing paths</h2>
            <ul class="lms-link-list">
              {filingPaths.map((link) => (
                <li><a href={link.href}>{link.anchor}</a></li>
              ))}
            </ul>
          </>
        )}
      </div>
    </section>
  )}

  {hub && (
    <section class="section" id="faq">
      <div class="container" style="max-width:720px;">
        <h2 class="section-title">Questions</h2>
        <div class="faq-list">
          {hub.faqs.map((faq) => (
            <details class="faq-item">
              <summary class="faq-q">{faq.q}<span class="faq-toggle">+</span></summary>
              <div class="faq-a"><p>{faq.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {!hub && isCore && (
    <section class="section section-alt">
      <div class="container">
        <h2 class="section-title">{type.name} by state</h2>
        <p class="section-sub">{rows.length} states. Required means a statewide license, permit, or registration of this type is the usual rule — not that every business model is in scope.</p>
        <div class="lms-table-wrap">
          <table class="lms-table">
            <thead>
              <tr>
                <th>State</th>
                <th>Statewide license</th>
                <th>Agency</th>
                <th>Filing</th>
              </tr>
            </thead>
            <tbody>
              {rows.map(({ state, fact }) => (
                <tr>
                  <td>
                    <a href={comboPath(state.slug, type.slug)}>{state.name}</a>
                  </td>
                  <td>{requiredLabel(fact.required)}</td>
                  <td>
                    <a href={fact.agencyUrl} target="_blank" rel="noopener">{fact.agencyName}</a>
                  </td>
                  <td>{filingLabel(fact.filing)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {filingPaths.length > 0 && (
          <>
            <h2 class="lms-subhead">State filing paths</h2>
            <ul class="lms-link-list">
              {filingPaths.map((link) => (
                <li><a href={link.href}>{link.anchor}</a></li>
              ))}
            </ul>
          </>
        )}
      </div>
    </section>
  )}

  {!isCore && (
    <section class="section section-alt">
      <div class="container lms-prose">
        <h2>How to find the state desk</h2>
        <p>
          Start at the <a href="/states">state index</a> and open the financial regulator
          listed there, then follow that agency’s insurance, contractor, or charities
          links. We do not generate 50 thin pages for adjacent filings.
        </p>
        <ul class="lms-state-list">
          {coreLicenseTypes.map((t) => (
            <li><a href={`/directory/${t.slug}`}>{t.name}</a>: core vertical with pages for the 50 states and DC</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container" style="max-width:720px;">
      <FileWithCornerstone topic={`a ${type.shortName} filing`} />
      <p style="margin-top:16px;">
        <a href={type.cornerstoneUrl} target="_blank" rel="noopener">Cornerstone’s {type.name.toLowerCase()} desk</a>
        {" · "}
        <a href="/guides/nmls">How NMLS filings work</a>
        {" · "}
        <a href="/states">All states</a>
      </p>
      <DirectoryDisclaimer />
    </div>
  </section>
</Layout>
