---
import Layout from '../layouts/Layout.astro';
import LicenseWizard from '../components/LicenseWizard.jsx';

const faqs = [
  { q: "Do I need a business license?", a: "Most cities and counties require a general business license. Financial services, healthcare, construction, and food service almost always need a state license on top of that. Use the <a href='#wizard'>roadmap wizard</a> or the <a href='/directory'>directory</a> to see which desk applies." },
  { q: "How long does licensing take?", a: "This site does not quote processing times. Each agency sets its own review clock. For timelines, use <a href='https://fastlicense.com' target='_blank' rel='noopener'>fastlicense.com</a>." },
  { q: "What does it cost?", a: "This site does not quote service fees or government fee bands. Confirm the current fee on the agency checklist. To compare providers and costs, use <a href='https://licensestore.com' target='_blank' rel='noopener'>licensestore.com</a>." },
  { q: "Can't I just do it myself?", a: "Yes. The agency will take a complete application from the applicant. <a href='https://cornerstonelicensing.com' target='_blank' rel='noopener'>Cornerstone Licensing</a> prepares and files if you want that done for you." },
  { q: "What about multi-state licensing?", a: "There is no national license for these verticals. File in each state where the customer, borrower, or debtor lives. The <a href='/states'>state directory</a> names the agency for each core license." },
  { q: "Who actually files my application?", a: "Filings arranged through this site are prepared and submitted by <a href='https://cornerstonelicensing.com' target='_blank' rel='noopener'>Cornerstone Licensing</a>. This site’s job is who needs the license and where to file it." }
];
---

<Layout
  title="LicensingMadeSimple — Who needs the license, where to file"
  description="50-state directory of collection, lending, money-transmitter, and mortgage licenses: who typically needs each one and which agency takes the filing. Roadmap wizard included."
>
  <section class="hero">
    <div class="container">
      <h1>Business Licensing,<br/><span>Made Simple.</span></h1>
      <p>Answer 3 questions. Get your personalized licensing roadmap. Let experts handle the rest.</p>
      <a href="#wizard" class="hero-cta">Get Your Roadmap</a>
    </div>
  </section>

  <!-- WHY IT'S CONFUSING -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Why Licensing Feels So Hard</h2>
      <p class="section-sub">It's not you. The system is genuinely confusing. We built this site to fix that.</p>
      <div class="card-grid">
        <div class="card">
          <h3>Every state is different</h3>
          <p>Different forms. Different agencies. Different filing systems. What works in Texas doesn't work in New York. There's no single source of truth.</p>
        </div>
        <div class="card">
          <h3>The jargon is impenetrable</h3>
          <p>"Surety bond." "NMLS filing." "Deficiency notice." "Obligee." The licensing world speaks its own language, and nobody translates it for you.</p>
        </div>
        <div class="card">
          <h3>Small mistakes cause big delays</h3>
          <p>One wrong box checked, one missing document, one incorrect fee amount — the agency sends the application back. A typo can restart the review.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WIZARD -->
  <section class="section section-alt" id="wizard-section">
    <div class="container">
      <h2 class="section-title">Your Licensing Roadmap</h2>
      <p class="section-sub">3 questions. No jargon. The license type and the usual filing desk.</p>
      <LicenseWizard client:load />
    </div>
  </section>

  <!-- DIRECTORY -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Who Needs What, Where to File</h2>
      <p class="section-sub">A 50-state directory for Cornerstone’s four core verticals. Official agencies. No invented fees.</p>
      <div class="card-grid lms-core-grid">
        <a class="card lms-dir-card" href="/directory/collection">
          <h3>Collection / ARM</h3>
          <p>Who needs a collection-agency or debt-collector license, which states issue one, and which board or department takes the filing.</p>
          <span class="lms-card-link">Open collection directory →</span>
        </a>
        <a class="card lms-dir-card" href="/directory/lending">
          <h3>Consumer &amp; commercial lending</h3>
          <p>Which agency licenses consumer-finance and related lender activity, and how the typical NMLS path works.</p>
          <span class="lms-card-link">Open lending directory →</span>
        </a>
        <a class="card lms-dir-card" href="/directory/money-transmitters">
          <h3>Money transmitters</h3>
          <p>State money-transmitter licenses plus the separate FinCEN MSB registration. New York’s BitLicense called out where it applies.</p>
          <span class="lms-card-link">Open MTL directory →</span>
        </a>
        <a class="card lms-dir-card" href="/directory/mortgage">
          <h3>Mortgage</h3>
          <p>SAFE Act company and MLO filings through NMLS, including the states that split mortgage onto a real-estate or SML desk.</p>
          <span class="lms-card-link">Open mortgage directory →</span>
        </a>
      </div>
      <p style="text-align:center;margin-top:28px;">
        <a href="/states">Browse all 50 states</a>
        {" · "}
        <a href="/directory">Full directory</a>
        {" · "}
        <a href="/guides/nmls">What NMLS is</a>
      </p>
    </div>
  </section>

  <!-- HOW WE SIMPLIFY IT -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">How We Make It Simple</h2>
      <p class="section-sub">You focus on your business. We handle the licensing.</p>
      <div class="card-grid">
        <div class="card">
          <div style="font-size:2rem; margin-bottom:12px;">1</div>
          <h3>Tell us what you need</h3>
          <p>Use the roadmap wizard or the directory. We need your business type and state(s). The site names the agency; Cornerstone can file.</p>
        </div>
        <div class="card">
          <div style="font-size:2rem; margin-bottom:12px;">2</div>
          <h3>The application is filed</h3>
          <p>Your specialist prepares the application, assembles documents, files with the agency or NMLS, and answers deficiency letters. This site does not quote prep or review times.</p>
        </div>
        <div class="card">
          <div style="font-size:2rem; margin-bottom:12px;">3</div>
          <h3>You're licensed</h3>
          <p>We track your application through approval and deliver your license. Then we monitor renewal deadlines so it never lapses.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="section section-alt">
    <div class="container" style="max-width: 720px; text-align: center;">
      <h2 class="section-title">Who's Behind This</h2>
      <p style="color: var(--text-secondary); font-size: 0.95rem; max-width: 560px; margin: 0 auto 28px;">
        All licensing work is handled by Cornerstone Licensing, one of the most experienced licensing firms in the United States.
      </p>
      <div class="card-grid lms-core-grid" style="text-align: left; max-width: 640px; margin: 0 auto;">
        <div class="card">
          <h3>Who files</h3>
          <p>Applications arranged here are prepared and submitted by <a href="https://cornerstonelicensing.com" target="_blank" rel="noopener">Cornerstone Licensing</a>. We do not reprint their filing counts or approval rates.</p>
        </div>
        <div class="card">
          <h3>Where we cover</h3>
          <p>The directory lists official agencies in all 50 states for the four core verticals. Confirm every checklist on the regulator’s site before you apply.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container" style="max-width: 720px;">
      <h2 class="section-title">Common Questions</h2>
      <div style="margin-top: 32px;">
        {faqs.map(f => (
          <details class="faq-item">
            <summary class="faq-q">{f.q}<span class="faq-toggle">+</span></summary>
            <div class="faq-a" set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Ready to file?</h2>
      <p>Use the roadmap to see the license type, then have Cornerstone prepare and file it.</p>
      <a href="https://cornerstonelicensing.com" target="_blank" rel="noopener">Talk with Cornerstone</a>
    </div>
  </section>
</Layout>
