---
import Layout from '../layouts/Layout.astro';
import LicenseWizard from '../components/LicenseWizard.jsx';

const faqs = [
  { q: "Do I need a business license?", a: "Almost certainly. If you're operating a business in the United States, you need at least a general business license in most cities and counties. Some industries (financial services, healthcare, construction, food service) require additional specialized licenses at the state level." },
  { q: "How long does licensing take?", a: "It depends on the license type. Simple business licenses: 1-4 weeks. Trade licenses (contractor, real estate): 2-8 weeks. Financial services licenses: 4-52 weeks. Use our <a href='#wizard'>roadmap wizard</a> to see the typical timeline for your situation." },
  { q: "What does it cost?", a: "Two costs to plan for: the service fee (what you pay a licensing professional to prepare and file your application) and the government filing fee (what the state charges). Service fees range from $200-$8,000 depending on complexity. Government fees vary by state. You get exact numbers before committing." },
  { q: "Can't I just do it myself?", a: "You can. But licensing is detail work. One wrong form, one missing document, one incorrect fee, and your application gets sent back. That means weeks of delays. Professional preparers have a 97% first-submission approval rate because they've done this hundreds of thousands of times. Most people find the time savings alone are worth the service fee." },
  { q: "What about multi-state licensing?", a: "Multi-state is where professional help pays for itself fastest. Every state has different forms, different fees, different requirements, and different deadlines. A specialist coordinates all of it and tracks every deadline. Most multi-state clients save 60-80% of the time they'd spend doing it themselves." },
  { q: "Who actually files my application?", a: "All applications through LicensingMadeSimple are prepared and filed by <a href='https://cornerstonelicensing.com' target='_blank' rel='noopener'>Cornerstone Licensing</a> — 28 years in business, 525,000+ filings, 99.995% on-time submission rate. One dedicated specialist handles your application from start to finish." }
];
---

<Layout title="LicensingMadeSimple — Business Licensing Without the Confusion">
  <section class="hero">
    <div class="container">
      <h1>Business Licensing,<br/><span>Made Simple.</span></h1>
      <p>Answer 3 questions. Get your personalized licensing roadmap. Let experts handle the rest.</p>
      <a href="#wizard" class="hero-cta">Get Your Roadmap</a>
    </div>
  </section>

  <!-- WHY IT'S CONFUSING -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Why Licensing Feels So Hard</h2>
      <p class="section-sub">It's not you. The system is genuinely confusing. We built this site to fix that.</p>
      <div class="card-grid">
        <div class="card">
          <h3>Every state is different</h3>
          <p>Different forms. Different fees. Different agencies. Different timelines. What works in Texas doesn't work in New York. There's no single source of truth.</p>
        </div>
        <div class="card">
          <h3>The jargon is impenetrable</h3>
          <p>"Surety bond." "NMLS filing." "Deficiency notice." "Obligee." The licensing world speaks its own language, and nobody translates it for you.</p>
        </div>
        <div class="card">
          <h3>Small mistakes cause big delays</h3>
          <p>One wrong box checked, one missing document, one incorrect fee amount — your application goes to the back of the line. Weeks lost over a typo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WIZARD -->
  <section class="section section-alt" id="wizard-section">
    <div class="container">
      <h2 class="section-title">Your Licensing Roadmap</h2>
      <p class="section-sub">3 questions. No jargon. Your personalized plan in 30 seconds.</p>
      <LicenseWizard client:load />
    </div>
  </section>

  <!-- HOW WE SIMPLIFY IT -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">How We Make It Simple</h2>
      <p class="section-sub">You focus on your business. We handle the licensing.</p>
      <div class="card-grid">
        <div class="card">
          <div style="font-size:2rem; margin-bottom:12px;">1</div>
          <h3>Tell us what you need</h3>
          <p>Use the roadmap wizard or contact us. We need your business type, state(s), and timeline. That's it. We figure out the rest.</p>
        </div>
        <div class="card">
          <div style="font-size:2rem; margin-bottom:12px;">2</div>
          <h3>We handle everything</h3>
          <p>Your dedicated specialist prepares the application, assembles documents, files with the state, and handles any follow-up. Average prep time: 3 business days.</p>
        </div>
        <div class="card">
          <div style="font-size:2rem; margin-bottom:12px;">3</div>
          <h3>You're licensed</h3>
          <p>We track your application through approval and deliver your license. Then we monitor renewal deadlines so it never lapses.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="section section-alt">
    <div class="container" style="max-width: 720px; text-align: center;">
      <h2 class="section-title">Who's Behind This</h2>
      <p style="color: var(--text-secondary); font-size: 0.95rem; max-width: 560px; margin: 0 auto 28px;">
        All licensing work is handled by Cornerstone Licensing, one of the most experienced licensing firms in the United States.
      </p>
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;">
        <div class="card" style="text-align: center; padding: 20px;">
          <div style="font-size: 1.6rem; font-weight: 900; color: var(--primary);">525K+</div>
          <div style="font-size: 0.78rem; color: var(--text-muted);">Filings completed</div>
        </div>
        <div class="card" style="text-align: center; padding: 20px;">
          <div style="font-size: 1.6rem; font-weight: 900; color: var(--primary);">28</div>
          <div style="font-size: 0.78rem; color: var(--text-muted);">Years experience</div>
        </div>
        <div class="card" style="text-align: center; padding: 20px;">
          <div style="font-size: 1.6rem; font-weight: 900; color: var(--primary);">97%</div>
          <div style="font-size: 0.78rem; color: var(--text-muted);">First-try approval</div>
        </div>
        <div class="card" style="text-align: center; padding: 20px;">
          <div style="font-size: 1.6rem; font-weight: 900; color: var(--primary);">50</div>
          <div style="font-size: 0.78rem; color: var(--text-muted);">States covered</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container" style="max-width: 720px;">
      <h2 class="section-title">Common Questions</h2>
      <div style="margin-top: 32px;">
        {faqs.map(f => (
          <details class="faq-item">
            <summary class="faq-q">{f.q}<span class="faq-toggle">+</span></summary>
            <div class="faq-a" set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Ready to Get Started?</h2>
      <p>Get your personalized licensing roadmap in 30 seconds. No commitment.</p>
      <a href="#wizard">Get Your Roadmap</a>
    </div>
  </section>
</Layout>
