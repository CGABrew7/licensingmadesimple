---
import Layout from '../layouts/Layout.astro';

const faqs = [
  { q: "Do I need a business license?", a: "Almost certainly. Most cities/counties require a general business license, and many industries require additional state licenses. Use our <a href='/#wizard'>roadmap wizard</a> to find out what applies to your situation." },
  { q: "How long does it take?", a: "Simple licenses: 1-4 weeks. Moderate (contractor, restaurant): 2-8 weeks. Complex (financial services): 1-12 months. The biggest variable is application quality — clean applications get approved faster." },
  { q: "What does it cost?", a: "Service fees range from $200-$8,000 depending on complexity. Government filing fees vary by state. You get exact numbers before committing to anything." },
  { q: "Can I do it myself?", a: "Yes, but professionals have a 97% first-submission approval rate vs. significantly higher rejection rates for DIY applications. Each rejection adds 2-4 weeks of delay. For most people, the time savings alone justify the service fee." },
  { q: "What about multiple states?", a: "Multi-state licensing is where professional help adds the most value. A specialist coordinates filings across all states and tracks every deadline. Most multi-state clients save 60-80% of the time they'd spend doing it themselves." },
  { q: "Who does the actual work?", a: "All applications are prepared and filed by <a href='https://cornerstonelicensing.com' target='_blank' rel='noopener'>Cornerstone Licensing</a> — 28 years in business, 525,000+ filings, 99.995% on-time rate. One specialist handles your case from start to finish." },
  { q: "What's included?", a: "Application preparation, document assembly, filing, status tracking, deficiency response, and approval confirmation. Surety bond procurement is included for licenses that require bonds. Government filing fees are quoted separately." },
  { q: "Do you handle renewals?", a: "Yes. All renewal deadlines are tracked automatically. Your specialist files renewals proactively so your licenses never lapse." }
];
---

<Layout title="FAQ — LicensingMadeSimple" description="Common questions about business licensing.">
  <section class="page-hero">
    <div class="container">
      <h1>Common Questions</h1>
      <p>Quick answers about licensing.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 720px;">
      {faqs.map(f => (
        <details class="faq-item">
          <summary class="faq-q">{f.q}<span class="faq-toggle">+</span></summary>
          <div class="faq-a" set:html={f.a} />
        </details>
      ))}
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Still Have Questions?</h2>
      <p>Contact us or use the licensing wizard.</p>
      <a href="/contact">Contact Us</a>
    </div>
  </section>
</Layout>
