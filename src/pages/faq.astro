---
import Layout from '../layouts/Layout.astro';

const faqs = [
  { q: "Do I need a business license?", a: "Most cities and counties require a general business license. Many industries also need a state license. Financial-services work (collection, lending, money transmission, mortgage) is licensed state by state. Use the <a href='/#wizard'>roadmap wizard</a> or the <a href='/directory'>directory</a> to see who typically needs which filing." },
  { q: "Who needs a state financial-services license?", a: "Third-party collectors and many debt buyers; companies that make consumer loans above a state’s trigger; businesses that transmit customer funds or sell payment instruments; and firms that originate, broker, or service residential mortgages. Banks and credit unions lending under a charter are usually exempt from the non-depository license. Confirm the exact category with the agency." },
  { q: "Where do I file?", a: "With the state agency that issues that license — often a banking department, DFI, collection board, or secretary of state. Mortgage, many lender, and most money-transmitter applications go through <a href='/guides/nmls'>NMLS</a>. Collection is mixed: some states use NMLS, some a board, and some issue no statewide collection license. Open the <a href='/states'>state index</a> for the desk." },
  { q: "How long does it take?", a: "A state license page shows a timeline only when a regulator or NMLS source states one. A blank cell is not an estimate. A deficiency letter can reset the agency clock. For clocks this directory has not verified, use <a href='https://fastlicense.com' target='_blank' rel='noopener'>fastlicense.com</a>." },
  { q: "What does it cost?", a: "A state license page quotes a government fee or bond only when that cell cites the state regulator or NMLS. A blank cell is not an estimate. For cited fee lines, use <a href='https://licensestore.com/costs/' target='_blank' rel='noopener'>LicenseStore costs</a>. For filing paths, use <a href='https://licensestore.com/compare/' target='_blank' rel='noopener'>LicenseStore compare</a>." },
  { q: "Can I do it myself?", a: "Yes. The agency will take a complete application from the applicant. The work is assembling the right authority, control-person disclosures, and any bond the statute requires. <a href='https://cornerstonelicensing.com' target='_blank' rel='noopener'>Cornerstone Licensing</a> prepares and files if you want that done for you." },
  { q: "What about multiple states?", a: "There is no national license for these verticals. You file in each state where the customer, borrower, or debtor lives — not only where your office sits. The <a href='/states'>state directory</a> lists the agency for each core license." },
  { q: "Who does the actual work?", a: "Filings arranged through this site are prepared and submitted by <a href='https://cornerstonelicensing.com' target='_blank' rel='noopener'>Cornerstone Licensing</a>. This site’s job is to name who needs the license and which desk takes the application. Filing counts and approval rates are not reprinted here; read those on Cornerstone’s own site." },
  { q: "What's included if Cornerstone files?", a: "Application preparation, document assembly, filing with the agency or NMLS, deficiency response, and renewal tracking. If the statute requires a surety bond, they place it. Government fees are paid to the agency, not set on this site." },
  { q: "Do you handle renewals?", a: "Cornerstone tracks renewal dates and files renewals so a license does not lapse. Confirm each state’s renewal calendar on the regulator’s site." }
];
---

<Layout title="FAQ — LicensingMadeSimple" description="Who needs a U.S. business or financial-services license, and which agency takes the filing.">
  <section class="page-hero">
    <div class="container">
      <h1>Common Questions</h1>
      <p>Who needs the license, and where it is filed.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 720px;">
      {faqs.map(f => (
        <details class="faq-item">
          <summary class="faq-q">{f.q}<span class="faq-toggle">+</span></summary>
          <div class="faq-a" set:html={f.a} />
        </details>
      ))}
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>See the license and the desk.</h2>
      <p>Three questions name the license type. The full state list stays in the directory.</p>
      <a class="cta-btn" href="/#wizard">Get Your Roadmap</a>
    </div>
  </section>
</Layout>
