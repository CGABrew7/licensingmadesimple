---
import '../styles/global.css';
import '@fontsource/geist-sans/latin-400.css';
import '@fontsource/geist-sans/latin-500.css';
import '@fontsource/geist-sans/latin-600.css';
import '@fontsource/geist-sans/latin-700.css';
import Logo from '../components/Logo.astro';
interface Props { title: string; description?: string; }
const { title, description = "Who needs which U.S. business license, and where to file it. 50-state directory for collection, lending, money transmitters, and mortgage — plus a 3-question roadmap." } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://licensingmadesimple.com").href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <nav class="nav">
    <div class="nav-inner">
      <Logo />
      <div class="nav-desktop">
        <a href="/directory">Directory</a>
        <a href="/states">States</a>
        <a href="/guides">Guides</a>
        <a href="/about">About</a>
        <a href="/faq">FAQ</a>
        <a href="/#wizard" class="nav-cta">Get Your Roadmap</a>
      </div>
      <div class="nav-mobile">
        <a href="/#wizard" class="nav-cta">Get Your Roadmap</a>
        <details class="nav-drawer">
          <summary>
            <span class="sr-only">Open menu</span>
            <span class="burger" aria-hidden="true"></span>
          </summary>
          <div class="nav-drawer-panel">
            <a href="/directory">Directory</a>
            <a href="/states">States</a>
            <a href="/guides">Guides</a>
            <a href="/about">About</a>
            <a href="/faq">FAQ</a>
          </div>
        </details>
      </div>
    </div>
  </nav>

  <slot />

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <Logo tone="inverse" />
          <p>A 50-state directory of who needs the license and which agency takes the filing, plus a three-question roadmap.</p>
        </div>
        <div>
          <h4>Directory</h4>
          <a href="/directory">License types</a>
          <a href="/states">All 50 states</a>
          <a href="/directory/mortgage">Mortgage</a>
          <a href="/directory/collection">Collection / ARM</a>
        </div>
        <div>
          <h4>Guides</h4>
          <a href="/guides">All Guides</a>
          <a href="/guides/nmls">What NMLS is</a>
          <a href="/guides/first-business-license">Your First License</a>
          <a href="/guides/multi-state">Multi-State Licensing</a>
        </div>
        <div>
          <h4>Site</h4>
          <a href="/about">About</a>
          <a href="/faq">FAQ</a>
          <a href="/contact">Contact</a>
          <a href="/privacy">Privacy</a>
        </div>
      </div>
      <p class="footer-note">Agency names and filing paths come from public regulator and NMLS sources already in the directory. This site does not quote fees, bond amounts, or processing times, and it does not reprint filing counts. Confirm the current checklist with the agency before you apply. Not legal advice.</p>
      <div class="footer-bottom">
        <span>&copy; 2026 LicensingMadeSimple. All rights reserved.</span>
        <span>Licensing services by <a href="https://cornerstonelicensing.com" target="_blank" rel="noopener">Cornerstone Licensing</a></span>
      </div>
    </div>
  </footer>
</body>
</html>
