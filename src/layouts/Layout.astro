---
import '../styles/global.css';
import '@fontsource/geist-sans/latin-400.css';
import '@fontsource/geist-sans/latin-500.css';
import '@fontsource/geist-sans/latin-600.css';
import '@fontsource/geist-sans/latin-700.css';
import Logo from '../components/Logo.astro';
interface Props { title: string; description?: string; jsonLd?: unknown | unknown[]; robots?: string; }
const { title, description = "Who needs which U.S. business license, and where to file it. Directory for collection, lending, money transmitters, and mortgage in the 50 states and DC, plus a 3-question roadmap.", jsonLd, robots } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://licensingmadesimple.com").href;
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "LicensingMadeSimple",
  url: "https://licensingmadesimple.com",
  logo: "https://licensingmadesimple.com/logo-lockup.png",
  description: "A directory of who needs a collection, lending, money transmitter, or mortgage license in the 50 states and DC, and which agency takes the filing.",
  sameAs: ["https://cornerstonelicensing.com"],
};
const extraJsonLd = jsonLd == null ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const jsonLdBlocks = [organization, ...extraJsonLd];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  {robots && <meta name="robots" content={robots} />}
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {jsonLdBlocks.map((block) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(block).replace(/</g, "\\u003c")} />
  ))}
  <script type="text/javascript" is:inline>(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window, document, "clarity", "script", "z2r4cb6gso");</script>
</head>
<body>
  <nav class="nav" aria-label="Primary">
    <div class="nav-inner">
      <Logo />
      <div class="nav-desktop">
        <a href="/directory">Directory</a>
        <a href="/states">States</a>
        <a href="/guides">Guides</a>
        <a href="/about">About</a>
        <a href="/faq">FAQ</a>
        <a href="/#wizard" class="nav-cta">Get Your Roadmap</a>
      </div>
      <div class="nav-mobile">
        <a href="/#wizard" class="nav-cta">Get Your Roadmap</a>
        <details class="nav-drawer">
          <summary>
            <span class="sr-only">Open menu</span>
            <span class="burger" aria-hidden="true"></span>
          </summary>
          <div class="nav-drawer-panel">
            <a href="/directory">Directory</a>
            <a href="/states">States</a>
            <a href="/guides">Guides</a>
            <a href="/about">About</a>
            <a href="/faq">FAQ</a>
          </div>
        </details>
      </div>
    </div>
  </nav>

  <main id="main">
    <slot />
  </main>

  <footer class="footer" aria-label="Site footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <Logo tone="inverse" />
          <p>A directory of who needs the license and which agency takes the filing in the 50 states and DC, plus a three-question roadmap.</p>
        </div>
        <div>
          <h4>Directory</h4>
          <a href="/directory">License types</a>
          <a href="/states">50 states and DC</a>
          <a href="/directory/money-transmitters">Money transmitter licenses by state</a>
          <a href="/directory/collection">Collection agency licenses by state</a>
          <a href="/directory/mortgage">Mortgage licenses by state</a>
        </div>
        <div>
          <h4>Guides</h4>
          <a href="/guides">All Guides</a>
          <a href="/guides/nmls">What NMLS is</a>
          <a href="/guides/first-business-license">Your First License</a>
          <a href="/guides/multi-state">Multi-State Licensing</a>
        </div>
        <div>
          <h4>Site</h4>
          <a href="/about">About</a>
          <a href="/faq">FAQ</a>
          <a href="/contact">Contact</a>
          <a href="/privacy">Privacy</a>
          <a href="/llms.txt">llms.txt</a>
        </div>
      </div>
      <p class="footer-note">Fee, bond, and timeline cells on a state license page cite a state regulator, a statute, or the NMLS chart. If a figure could not be verified, the cell says Varies, see regulator and links the agency. This site does not reprint filing counts. Confirm the current checklist with the agency before you apply. Not legal advice.</p>
      <div class="footer-bottom">
        <span>&copy; 2026 LicensingMadeSimple. All rights reserved.</span>
        <span>Licensing services by <a href="https://cornerstonelicensing.com" target="_blank" rel="noopener">Cornerstone Licensing</a></span>
      </div>
    </div>
  </footer>
</body>
</html>
