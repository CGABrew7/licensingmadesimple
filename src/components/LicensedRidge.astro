---
/** Scroll climb for the three path steps already published on the homepage. */
const steps = [
  {
    n: "01",
    at: "1",
    title: "Tell us what you need",
    text: "Use the roadmap wizard or the directory. We need your business type and state(s). The site names the agency; Cornerstone can file.",
  },
  {
    n: "02",
    at: "2",
    title: "The application is filed",
    text: "Your specialist prepares the application, assembles documents, files with the agency or NMLS, and answers deficiency letters.",
  },
  {
    n: "03",
    at: "3",
    title: "You're licensed",
    text: "We track your application through approval and deliver your license. Then we monitor renewal deadlines so it stays current.",
  },
];

const route = "M 36 640 C 74.00 593.33 116.67 514.67 150.00 500.00 C 183.33 485.33 203.00 580.00 236.00 552.00 C 269.00 524.00 312.67 358.67 348.00 332.00 C 383.33 305.33 417.67 418.00 448.00 392.00 C 478.33 366.00 503.33 230.67 530.00 176.00 C 556.67 121.33 582.00 101.33 608.00 64.00";
---

<section class="ridge" id="how-path" data-step="3" style="--ridge: 1" aria-labelledby="how-path-title">
  <script is:inline>
    (function () {
      var root = document.currentScript && document.currentScript.parentElement;
      if (!root) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        root.classList.add("is-static");
        return;
      }
      root.classList.add("is-ready");
      root.dataset.step = "0";
      root.style.setProperty("--ridge", "0");
      var pin = window.matchMedia("(min-width: 1040px) and (min-height: 780px)").matches;
      root.classList.add(pin ? "is-pinned" : "is-flow");
    })();
  </script>
  <div class="ridge-sticky">
    <div class="container ridge-grid">
      <div class="ridge-copy">
        <h2 id="how-path-title">How the path works</h2>
        <p class="ridge-lead">You keep running the business. The roadmap names the desk. Cornerstone can file.</p>
      </div>
      <figure class="ridge-figure">
        <figcaption class="ridge-summit">Licensed</figcaption>
        <div class="ridge-canvas">
          <svg class="ridge-svg" viewBox="0 0 640 720" role="img" aria-label="A ridge line rising to Licensed">
            <path class="ridge-far" d="M 18 188 C 78 168 128 214 186 176 C 248 136 292 168 352 146 C 412 124 454 156 512 132" />
            <path class="ridge-far ridge-far-2" d="M 86 128 C 150 146 196 96 262 108 C 328 120 366 78 438 92" />
            <path class="ridge-ghost" d={route} />
            <path class="ridge-echo" d={route} transform="translate(0 22)" />
            <path class="ridge-line" d={route} />
            <path class="ridge-datum" d="M 28 656 V 676 M 28 668 H 78" />
          </svg>
          <span class="ridge-dot dot-1" style="left: 23.4375%; top: 69.4444%" aria-hidden="true"></span>
          <span class="ridge-dot dot-2" style="left: 54.375%; top: 46.1111%" aria-hidden="true"></span>
          <span class="ridge-dot dot-3" style="left: 82.8125%; top: 24.4444%" aria-hidden="true"></span>
        </div>
      </figure>
      <ol class="ridge-steps">
        {steps.map((step) => (
          <li class="ridge-step" data-at={step.at}>
            <span class="ridge-mark" aria-hidden="true">
              <svg viewBox="0 0 16 16">
                <path d="M3.1 8.15 L6.45 11.35 L12.7 4.55" />
              </svg>
            </span>
            <div>
              <h3><span class="ridge-num">{step.n}</span> {step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <script is:inline>
    (function () {
      var root = document.getElementById("how-path");
      if (!root || root.classList.contains("is-static") || !root.classList.contains("is-ready")) return;
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
      var pinQuery = window.matchMedia("(min-width: 1040px) and (min-height: 780px)");
      var line = root.querySelector(".ridge-line");
      var items = Array.prototype.slice.call(root.querySelectorAll(".ridge-step"));
      var thresholds = [0.2, 0.54, 0.94];
      var len = 1;
      var active = false;
      var ticking = false;
      var stepNow = "-1";

      function measure() {
        if (!line || !line.getTotalLength) return;
        try {
          len = line.getTotalLength() || 1;
          line.style.strokeDasharray = String(len);
        } catch (err) {
          len = 1;
        }
      }

      function applyMode() {
        if (reduce.matches) {
          root.classList.remove("is-pinned", "is-flow", "is-ready");
          root.classList.add("is-static");
          root.dataset.step = "3";
          root.style.setProperty("--ridge", "1");
          if (line) {
            line.style.strokeDasharray = "none";
            line.style.strokeDashoffset = "0";
          }
          items.forEach(function (el) { el.removeAttribute("aria-current"); });
          var last = items[items.length - 1];
          if (last) last.setAttribute("aria-current", "step");
          return;
        }
        var pin = pinQuery.matches;
        root.classList.toggle("is-pinned", pin);
        root.classList.toggle("is-flow", !pin);
        measure();
      }

      function setStep(n) {
        var key = String(n);
        if (key === stepNow) return;
        stepNow = key;
        root.dataset.step = key;
        var current = n >= 3 ? 3 : n + 1;
        items.forEach(function (el) {
          var at = Number(el.getAttribute("data-at"));
          if (at === current) el.setAttribute("aria-current", "step");
          else el.removeAttribute("aria-current");
        });
      }

      function flowProgress(view) {
        var trigger = view * 0.5;
        var first = items[0];
        var last = items[items.length - 1];
        if (!first || !last) return 0;
        var firstTop = first.getBoundingClientRect().top;
        var lastTop = last.getBoundingClientRect().top;
        var span = lastTop - firstTop;
        if (span < 1) return firstTop < trigger ? 1 : 0;
        var raw = (trigger - firstTop) / span;
        if (raw <= 0) {
          var fig = root.querySelector(".ridge-canvas");
          var figTop = fig ? fig.getBoundingClientRect().top : firstTop;
          var lead = firstTop - figTop;
          if (lead < 1) return 0;
          var leadRaw = (trigger - figTop) / lead;
          if (leadRaw < 0) return 0;
          if (leadRaw > 1) leadRaw = 1;
          return leadRaw * 0.18;
        }
        var stepped = 0.2 + raw * 0.8;
        return stepped > 1 ? 1 : stepped;
      }

      function progress() {
        var rect = root.getBoundingClientRect();
        var view = window.innerHeight || 1;
        var p;
        if (root.classList.contains("is-pinned")) {
          var nav = 64;
          var total = root.offsetHeight - (view - nav);
          var scrolled = Math.min(Math.max(nav - rect.top, 0), Math.max(total, 0));
          p = total > 0 ? scrolled / total : 1;
        } else {
          p = flowProgress(view);
        }
        if (p < 0) p = 0;
        if (p > 1) p = 1;
        root.style.setProperty("--ridge", p.toFixed(4));
        if (line && len > 1) line.style.strokeDashoffset = String(len * (1 - p));
        var n = 0;
        if (p >= thresholds[0]) n = 1;
        if (p >= thresholds[1]) n = 2;
        if (p >= thresholds[2]) n = 3;
        setStep(n);
      }

      function onScroll() {
        if (!active || ticking || root.classList.contains("is-static")) return;
        ticking = true;
        requestAnimationFrame(function () {
          ticking = false;
          progress();
        });
      }

      applyMode();
      if (root.classList.contains("is-static")) return;

      if ("IntersectionObserver" in window) {
        var io = new IntersectionObserver(function (entries) {
          var entry = entries[0];
          active = !!entry && entry.isIntersecting;
          if (active) progress();
          else if (entry && entry.boundingClientRect.top > 0) {
            root.style.setProperty("--ridge", "0");
            if (line && len > 1) line.style.strokeDashoffset = String(len);
            setStep(0);
          } else {
            root.style.setProperty("--ridge", "1");
            if (line && len > 1) line.style.strokeDashoffset = "0";
            setStep(3);
          }
        }, { rootMargin: "120px 0px" });
        io.observe(root);
      } else {
        active = true;
      }

      progress();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", function () {
        applyMode();
        if (!root.classList.contains("is-static")) progress();
      }, { passive: true });
      if (reduce.addEventListener) reduce.addEventListener("change", function () {
        applyMode();
        if (!root.classList.contains("is-static")) progress();
      });
      if (pinQuery.addEventListener) pinQuery.addEventListener("change", function () {
        applyMode();
        progress();
      });
    })();
  </script>
</section>

<style>
  .ridge {
    --ridge: 1;
    background: #fff;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 56px 0 64px;
    color: var(--text);
  }
  .ridge-sticky { position: relative; }
  .ridge-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
    grid-template-areas:
      "copy chart"
      "steps chart";
    column-gap: 56px;
    row-gap: 28px;
    align-items: center;
  }
  .ridge-copy { grid-area: copy; min-width: 0; }
  .ridge-copy h2 {
    margin: 0 0 12px;
    font-size: clamp(2rem, 3.1vw, 2.85rem);
    font-weight: 600;
    letter-spacing: -0.038em;
    line-height: 1.05;
    max-width: 11em;
  }
  .ridge-lead {
    margin: 0;
    max-width: 36rem;
    color: var(--text-secondary);
    font-size: 1.02rem;
    line-height: 1.6;
  }
  .ridge-figure {
    grid-area: chart;
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
  }
  .ridge-summit {
    align-self: flex-end;
    margin: 0 0 8px;
    font-size: clamp(2.5rem, 4.4vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.048em;
    line-height: 0.88;
    color: var(--text-secondary);
    padding-bottom: 8px;
    background-image: linear-gradient(#0e1726, #0e1726);
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: calc(var(--ridge, 1) * 100%) 1px;
  }
  .ridge[data-step="3"] .ridge-summit { color: var(--text); }
  .ridge-canvas {
    position: relative;
    width: min(100%, 520px);
    aspect-ratio: 640 / 720;
  }
  .ridge-svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .ridge-far {
    fill: none;
    stroke: #0e1726;
    stroke-opacity: 0.14;
    stroke-width: 1.25;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
  .ridge-far-2 { stroke-opacity: 0.08; }
  .ridge-ghost,
  .ridge-echo,
  .ridge-line {
    fill: none;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
  .ridge-ghost {
    stroke: #0e1726;
    stroke-opacity: 0.16;
    stroke-width: 1.25;
  }
  .ridge-echo {
    stroke: #0e1726;
    stroke-opacity: 0.06;
    stroke-width: 1.25;
    transform: translate(0, 28px);
  }
  .ridge-line {
    stroke: #0e1726;
    stroke-width: 1.75;
  }
  .ridge.is-ready .ridge-line {
    stroke-dasharray: 4 9999;
    stroke-dashoffset: 0;
  }
  .ridge-datum {
    fill: none;
    stroke: #0e1726;
    stroke-opacity: 0.28;
    stroke-width: 1.25;
    stroke-linecap: square;
  }
  .ridge-dot {
    position: absolute;
    width: 11px;
    height: 11px;
    margin-left: -5.5px;
    margin-top: -5.5px;
    background: #fff;
    border: 1px solid #8b93a1;
    box-sizing: border-box;
  }
  .ridge[data-step="1"] .dot-1,
  .ridge[data-step="2"] .dot-1,
  .ridge[data-step="3"] .dot-1,
  .ridge[data-step="2"] .dot-2,
  .ridge[data-step="3"] .dot-2,
  .ridge[data-step="3"] .dot-3 {
    background: var(--cta);
    border-color: var(--cta);
  }
  .ridge-steps {
    grid-area: steps;
    list-style: none;
    margin: 0;
    padding: 2px 0 2px 0;
    display: grid;
    gap: 22px;
    position: relative;
    min-width: 0;
  }
  .ridge-steps::before,
  .ridge-steps::after {
    content: "";
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: #e3e6eb;
  }
  .ridge-steps::after {
    bottom: auto;
    height: calc(var(--ridge, 1) * (100% - 16px));
    background: #0e1726;
  }
  .ridge-step {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
    position: relative;
  }
  .ridge-mark {
    width: 16px;
    height: 16px;
    margin-top: 4px;
    display: grid;
    place-items: center;
    background: #fff;
    border: 1px solid #c5cdd6;
    color: transparent;
    position: relative;
    z-index: 1;
    box-sizing: border-box;
  }
  .ridge-mark svg { width: 12px; height: 12px; display: block; }
  .ridge-mark path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
  .ridge[data-step="1"] .ridge-step[data-at="1"] .ridge-mark,
  .ridge[data-step="2"] .ridge-step[data-at="1"] .ridge-mark,
  .ridge[data-step="3"] .ridge-step[data-at="1"] .ridge-mark,
  .ridge[data-step="2"] .ridge-step[data-at="2"] .ridge-mark,
  .ridge[data-step="3"] .ridge-step[data-at="2"] .ridge-mark,
  .ridge[data-step="3"] .ridge-step[data-at="3"] .ridge-mark {
    background: var(--cta);
    border-color: var(--cta);
    color: #fff;
  }
  .ridge-step h3 {
    margin: 0;
    font-size: 1.18rem;
    font-weight: 600;
    letter-spacing: -0.024em;
    line-height: 1.25;
  }
  .ridge-num {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-right: 8px;
  }
  .ridge-step p {
    margin: 6px 0 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 38rem;
  }
  .ridge.is-pinned {
    height: 280vh;
    padding: 0;
    background: transparent;
    border-bottom: 0;
  }
  .ridge.is-pinned .ridge-sticky {
    position: sticky;
    top: 64px;
    height: calc(100dvh - 64px);
    background: #fff;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    z-index: 1;
  }
  .ridge.is-pinned .ridge-grid {
    width: 100%;
    padding-top: 28px;
    padding-bottom: 28px;
  }
  .ridge.is-pinned .ridge-canvas {
    width: min(100%, 500px);
    max-height: calc(100dvh - 200px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ridge-mark,
    .ridge-dot,
    .ridge-summit {
      transition: background-color 160ms linear, border-color 160ms linear, color 180ms linear;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ridge {
      height: auto !important;
      padding: 56px 0 64px !important;
    }
    .ridge-sticky {
      position: relative !important;
      top: auto !important;
      height: auto !important;
      display: block !important;
    }
    .ridge-line {
      stroke-dasharray: none !important;
      stroke-dashoffset: 0 !important;
    }
    .ridge-mark,
    .ridge-dot,
    .ridge-summit { transition: none !important; }
  }

  @media (max-width: 1039px) {
    .ridge.is-pinned {
      height: auto;
      padding: 48px 0 56px;
      background: #fff;
      border-bottom: 1px solid var(--border);
    }
    .ridge.is-pinned .ridge-sticky,
    .ridge-sticky {
      position: relative;
      top: auto;
      height: auto;
      display: block;
      background: transparent;
      border-bottom: 0;
    }
    .ridge { padding: 48px 0 56px; }
    .ridge-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "copy"
        "chart"
        "steps";
      row-gap: 22px;
      align-items: start;
    }
    .ridge-figure { align-items: stretch; }
    .ridge-summit {
      font-size: clamp(2.15rem, 12vw, 3rem);
      margin-bottom: 6px;
    }
    .ridge-canvas {
      width: min(100%, 300px);
      max-height: none;
      margin-inline: auto;
    }
    .ridge-steps { gap: 18px; }
  }

  @media (max-width: 420px) {
    .ridge,
    .ridge.is-pinned { padding: 40px 0 48px; }
    .ridge-copy h2 { font-size: 1.85rem; }
    .ridge-lead,
    .ridge-step p { font-size: 0.92rem; }
    .ridge-step h3 { font-size: 1.05rem; }
    .ridge-canvas { width: min(100%, 240px); }
  }
</style>
