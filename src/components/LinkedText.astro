---
interface Link {
  phrase: string;
  href: string;
}

interface Props {
  text: string;
  links?: Link[];
}

const { text, links = [] } = Astro.props;
const pending = links.map((link) => ({ ...link }));

type Segment = { text: string; href?: string };
const segments: Segment[] = [];
let rest = text;

while (rest.length > 0) {
  let best: { phrase: string; href: string; index: number } | null = null;
  for (const link of pending) {
    const index = rest.indexOf(link.phrase);
    if (index >= 0 && (best === null || index < best.index || (index === best.index && link.phrase.length > best.phrase.length))) {
      best = { phrase: link.phrase, href: link.href, index };
    }
  }
  if (!best) {
    segments.push({ text: rest });
    break;
  }
  if (best.index > 0) segments.push({ text: rest.slice(0, best.index) });
  segments.push({ text: best.phrase, href: best.href });
  rest = rest.slice(best.index + best.phrase.length);
  const used = pending.findIndex((link) => link.phrase === best!.phrase && link.href === best!.href);
  if (used >= 0) pending.splice(used, 1);
}
---

{segments.map((segment) =>
  segment.href ? (
    <a
      href={segment.href}
      {...(segment.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}
    >{segment.text}</a>
  ) : (
    segment.text
  )
)}
