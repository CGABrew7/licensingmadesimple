---
interface Props {
  tone?: "default" | "inverse";
}
const { tone = "default" } = Astro.props;
---

<a href="/" class:list={["nav-logo", tone === "inverse" && "is-inverse"]}>
  <svg class="logo-mark" viewBox="0 0 22 22" aria-hidden="true">
    <rect x="1" y="1" width="8.5" height="8.5" rx="1.25" fill="currentColor"></rect>
    <rect x="12.5" y="1" width="8.5" height="8.5" rx="1.25" fill="currentColor"></rect>
    <rect x="1" y="12.5" width="8.5" height="8.5" rx="1.25" fill="currentColor"></rect>
    <rect x="12.5" y="12.5" width="8.5" height="8.5" rx="1.25" fill="currentColor"></rect>
  </svg>
  <span class="logo-word">Licensing Made Simple</span>
</a>
